{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/projeto.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/contato.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "source": "/projetos/:slug",
      "destination": "/api/projeto.php?slug=:slug"
    },
    {
      "source": "/contato",
      "destination": "/api/contato.php"
    },
    {
      "source": "/",
      "destination": "/api/index.php"
    }
  ]
}
